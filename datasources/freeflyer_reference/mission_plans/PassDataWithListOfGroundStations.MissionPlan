<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<FreeFlyerMissionPlan schemaVersion="8.0.0.12" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ProjectObjects>
    <Object>
      <MissionPlanSettings isConstant="false" isGlobal="true" name="MissionPlan">
        <Name>MissionPlan</Name>
        <Title>Pass Data with a List of Ground Stations</Title>
        <Description/>
        <Notes/>
      </MissionPlanSettings>
    </Object>
    <Object>
      <SimulationSettings isConstant="false" isGlobal="true" name="Simulation">
        <Name>Simulation</Name>
        <DataFiles>
          <DataFileSettings isConstant="false" isGlobal="true" name="Simulation_|dataFiles|">
            <Name>Simulation_|dataFiles|</Name>
            <EarthOrientationParametersFile>DEFAULT</EarthOrientationParametersFile>
            <PlanetaryEphemerisFile>DEFAULT</PlanetaryEphemerisFile>
            <MagneticFieldFile>DEFAULT</MagneticFieldFile>
            <ElectronDensityFile>DEFAULT</ElectronDensityFile>
            <DaylightSavingTimeFile>DEFAULT</DaylightSavingTimeFile>
            <StarFieldFile>DEFAULT</StarFieldFile>
            <DefaultAtmosphereModelFile>DEFAULT</DefaultAtmosphereModelFile>
            <DefaultGeopotentialFile>DEFAULT</DefaultGeopotentialFile>
            <DefaultHarrisPriesterDragFile>DEFAULT</DefaultHarrisPriesterDragFile>
            <DefaultGroundStationGeodeticsFile>DEFAULT</DefaultGroundStationGeodeticsFile>
            <DefaultSolidTideModelFile>DEFAULT</DefaultSolidTideModelFile>
          </DataFileSettings>
        </DataFiles>
        <IntervalMethods>
          <IntervalMethodSettings isConstant="false" isGlobal="true" name="Simulation_|intervalMethodSettings|">
            <Name>Simulation_|intervalMethodSettings|</Name>
            <SearchResolution displayed_units="s" units="s">10.0</SearchResolution>
            <ConvergenceTolerance displayed_units="s" units="s">0.1</ConvergenceTolerance>
            <ReportingBehavior>0</ReportingBehavior>
          </IntervalMethodSettings>
        </IntervalMethods>
        <Tolerances>
          <ToleranceSettings isConstant="false" isGlobal="true" name="Simulation_|toleranceSettings|">
            <Name>Simulation_|toleranceSettings|</Name>
            <CelestialObjectUpdateInterval displayed_units="s" units="s">0</CelestialObjectUpdateInterval>
            <LightTimeTolerance displayed_units="ns" units="ns">1000</LightTimeTolerance>
            <OrbitPointTolerance displayed_units="s" units="s">0.010</OrbitPointTolerance>
            <PropagationStoppingConditionTolerance displayed_units="s" units="s">1e-9</PropagationStoppingConditionTolerance>
          </ToleranceSettings>
        </Tolerances>
        <SGP4>
          <SGP4Settings isConstant="false" isGlobal="true" name="Simulation_|sgp4Settings|">
            <Name>Simulation_|sgp4Settings|</Name>
            <Path/>
            <LicensePath/>
            <LogFilePath/>
          </SGP4Settings>
        </SGP4>
        <Earth>
          <EarthModelSettings isConstant="false" isGlobal="true" name="Simulation_|earthSettings|">
            <Name>Simulation_|earthSettings|</Name>
            <OrientationModel>1</OrientationModel>
            <CIRFEvaluationMode>1</CIRFEvaluationMode>
            <ModelPolarMotion>true</ModelPolarMotion>
            <ModelCelestialPoleOffsets>true</ModelCelestialPoleOffsets>
            <ModelUT1Correction>true</ModelUT1Correction>
            <IonosphereOptions>
              <IonosphereOptions isConstant="false" isGlobal="true" name="Simulation_|earthSettings|_|ionoOptions|">
                <Name>Simulation_|earthSettings|_|ionoOptions|</Name>
                <MaximumHeight displayed_units="km" units="km">1000</MaximumHeight>
                <MinimumHeight displayed_units="km" units="km">80</MinimumHeight>
                <IntegrationStepSize displayed_units="km" units="km">25</IntegrationStepSize>
                <ScaleFactor displayed_units="" units="">1</ScaleFactor>
                <Model>0</Model>
                <IRIDataDirectory>DEFAULT</IRIDataDirectory>
              </IonosphereOptions>
            </IonosphereOptions>
          </EarthModelSettings>
        </Earth>
      </SimulationSettings>
    </Object>
    <Object>
      <ConsoleWindow isConstant="false" isGlobal="true" name="Console">
        <Name>Console</Name>
        <WindowTitle>Console</WindowTitle>
        <WordWrap>false</WordWrap>
        <CurrentTextColor>16777215</CurrentTextColor>
        <BackColor>2039583</BackColor>
        <Dimension displayed_units="" units="">10</Dimension>
        <DockMode>1</DockMode>
        <CurrentFontType>0</CurrentFontType>
        <UseStdOut>false</UseStdOut>
        <ShowOnRun>false</ShowOnRun>
      </ConsoleWindow>
    </Object>
  </ProjectObjects>

  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan demonstrates the use of the Spacecraft.PassData interval method to calculate passes between a Spacecraft
// and a List of GroundStation objects.

// Interval methods provide a means to precisely calculate the entry and exit times for a specified event. The precise time for
// each event can be calculated to nanosecond-level accuracy; the accuracy does not depend on the Spacecraft's propagation step size.

// Two configuration settings are used to control the accuracy of the event times:

//     Simulation.IntervalMethods.SearchResolution: Controls the minimum event duration for events that will not be skipped by the 
//     searching algorithm. The default value is 10 seconds, meaning that events shorter than 10 seconds may not be detected by 
//     default. The minimum setting is 1 nanosecond.

//     Simulation.IntervalMethods.ConvergenceTolerance: Controls the accuracy to which the time boundaries of events are resolved. The 
//     default value is 0.1 seconds, meaning that the start and end times of an event will be accurate to within 0.1 seconds by 
//     default. The minimum setting is 1 nanosecond.

// NOTE: The accuracy of interval methods and the minimum values for the aforementioned properties are dictated by the timing
// precision mode of your Mission Plan, which is nanosecond by default.


// Console Setup
Console.Dimension = 40;
Console.Show();
Console.WordWrap  = 1;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Cyan;
Console.WindowTitle = "Mission Plan Description";

Report  "This Mission Plan demonstrates the use of the Spacecraft.PassData interval method to calculate passes between a Spacecraft " +
       @"and a List of GroundStation objects.\n" to Console;

Report  "Interval methods provide a means to precisely calculate the entry and exit times for a specified event. The precise time for " +
       @"each event can be calculated to nanosecond-level accuracy; the accuracy does not depend on the Spacecraft's propagation step size.\n" to Console;

Console.CurrentTextColor = ColorTools.Lime;
Report @"Two configuration settings are used to control the accuracy of the event times:\n" to Console;
Report  "Simulation.IntervalMethods.SearchResolution: Controls the minimum event duration for events that will not be skipped by the " + 
        "searching algorithm. The default value is 10 seconds, meaning that events shorter than 10 seconds may not be detected by default. " + 
       @"The minimum setting is 1 nanosecond.\n" to Console;
Report  "Simulation.IntervalMethods.ConvergenceTolerance: Controls the accuracy to which the time boundaries of events are resolved. The default " +
        "value is 0.1 seconds, meaning that the start and end times of an event will be accurate to within 0.1 seconds by default. " + 
       @"The minimum setting is 1 nanosecond.\n" to Console;

Console.CurrentTextColor = ColorTools.Yellow;
Report  "NOTE: The accuracy of interval methods and the minimum values for the aforementioned properties are dictated by the timing precision " + 
       @"mode of your Mission Plan, which is nanosecond by default.\n" to Console;
               ]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Set Interval Method Accuracy</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Set Interval Method Accuracy

Simulation.IntervalMethods.SearchResolution = TIMESPAN(5 seconds);		// Default is 10 seconds
Simulation.IntervalMethods.ConvergenceTolerance = TIMESPAN(0.01 seconds);	// Default is 0.1 seconds
        ]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Objects</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Create Objects

Variable i;
Spacecraft sc;

// Set up List of GroundStations
List<GroundStation> gsList[8];

// Initialize each GroundStation from the Station Geodetics File
gsList[0].LoadFromStationGeodeticsFile("DS46");
gsList[1].LoadFromStationGeodeticsFile("DS16");
gsList[2].LoadFromStationGeodeticsFile("DS55");
gsList[3].LoadFromStationGeodeticsFile("KS2P");
gsList[4].LoadFromStationGeodeticsFile("JSCS");
gsList[5].LoadFromStationGeodeticsFile("CTSS");
gsList[6].LoadFromStationGeodeticsFile("MDLS");
gsList[7].LoadFromStationGeodeticsFile("VD3F");

// Set color for each GroundStation
For i = 0 to gsList.Count-1;

	gsList[i].Color = ColorTools.InterpolateColorRGB({ColorTools.Orange, ColorTools.Yellow, ColorTools.Green, ColorTools.Blue}, i/gsList.Count);

End;
        ]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Propagate Spacecraft and Calculate PassData</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Propagate Spacecraft and Calculate PassData

While (sc.ElapsedTime < TIMESPAN(3 days));

	For i = 0 to gsList.Count-1;

		Report sc.PassData(gsList[i]) to "..\_Output_Files\PassDataReport.txt";

	End;

	// View the objects and propagate the Spacecraft
	View sc, gsList;	
	Step sc;

End;
        ]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Announce Output Report</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Announce Output Report

Console.CurrentTextColor = ColorTools.OrangeRed;

Report "PassData report generated.  Open the report from the following location: '..\_Output_Files\PassDataReport.txt'" to Console;
Report "" to Console;
        ]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands></ProjectMissionSequence>

</FreeFlyerMissionPlan>
