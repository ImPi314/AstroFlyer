  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan demonstrates the use of the Force Model's UseOtherAcceleration to apply custom forces used in spacecraft propagation.  

// Three spacecraft with identical orbits are created. The first spacecraft, SC_SRP has the effects of Solar Radiation Pressure turned on 
// in the force model, SC_NoSRP has no forces due to SRP added, and SC_OtherAccels uses UseOtherAcceleration to apply
// the force due to SRP.

// Another option to define custom forces used in spacecraft propagation is to use a FreeFlyer Extension. A force model defined in an 
// Extension allows the force to be re-evaluated at each integration step as part of the FreeFlyer integration process. This 
// happens automatically when the Step command is used. When using Other Accelerations, the force can only be controlled, 
// modified, or updated by the user from the Mission Plan between Step commands. 

// Console Setup
Console.Dimension = 40;
Console.Show();
Console.WordWrap  = 1;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Yellow;
Console.WindowTitle = "Mission Plan Description";

Report "This Mission Plan demonstrates the use of the Force Model's UseOtherAcceleration to apply custom forces used in spacecraft propagation.  " to Console;
Report "" to Console;

Report "Three spacecraft with identical orbits are created. The first spacecraft, SC_SRP has the effects of Solar Radiation Pressure turned on in the force model, SC_NoSRP has no forces due to SRP added, and SC_OtherAccels uses UseOtherAcceleration to apply the force due to SRP. " to Console;
 Report "" to Console;

Report "FreeFlyer Extensions offer another option to define custom forces used in spacecraft propagation. A force model defined in an Extension allows the force to be re-evaluated at each integration step as part of the FreeFlyer integration process. This happens automatically when the Step command is used. When using Other Accelerations, the force can only be controlled, modified, or updated by the user from the Mission Plan between Step commands. " to Console;
Report "" to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Objects</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Create Objects

// Define constants used in Solar Radiation Pressure calculation
Global Variable AU =  Constants.AU;	// astronomical unit in km
Global Variable c = Constants.c;	// speed of light in km/s
Global Variable S = 1358.0;			// solar flux in W/m^2

// Create an array to store SRP values
Array SRP[3];

// Turn on other accelerations for SC_OtherAccels
(ScOtherAccels.Propagator AsType RK89).ForceModel.UseOtherAcceleration = 1;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>ComputeSRP Procedure</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// ComputeSRP Procedure

// Procedure to compute the solar radiation pressure on a spacecraft
Define Procedure ComputeSRP(Spacecraft sc, Array SRP);

	Array U[3];
	Vector SCToSun;

	SCToSun.BuildVector(9, Sun, sc);
	U = SCToSun.Element;

	SRP = (S*AU^2*sc.Cr*sc.SRPArea/1000000)/(sc.Mass*sc.Range(Sun)^2*c)*U.Normalized();

EndProcedure;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Propagate Spacecraft and Compare Trajectories</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Propagate Spacecraft and Compare Trajectories

While (ScOtherAccels.ElapsedTime < TIMESPAN(3 days));

	// Update plots
	Update ViewWindow1;
	Update PlotWindow1;

	// Compute Solar Radiation Pressure
	Call ComputeSRP(ScOtherAccels, SRP);

	// Apply Solar Radiation Pressure to SC_OtherAccels
	(ScOtherAccels.Propagator AsType RK89).ForceModel.OtherAccelerations[0] = SRP[0];
	(ScOtherAccels.Propagator AsType RK89).ForceModel.OtherAccelerations[1] = SRP[1];
	(ScOtherAccels.Propagator AsType RK89).ForceModel.OtherAccelerations[2] = SRP[2];

	// Step all spacecraft
	Step ScSRP;
		  
	Step ScOtherAccels;
		  
	Step ScNoSRP;

End;
]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands></ProjectMissionSequence>

</FreeFlyerMissionPlan>
