  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan reports the times when a Spacecraft is in contact with a Ground Station while also not being in the Earth's shadow.

// The two interval methods, ContactTimes and ShadowTimes, are used and the overlapping times are reported to the Console. The logic used in this Mission Plan can be used for other interval methods as well.

// Console Setup
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.Dimension = 35;
Console.WordWrap = 1;
Console.Show();

Report "" to Console;
Report "This Mission Plan reports the times when a Spacecraft is in contact with a Ground Station while also not being in the Earth's shadow." to Console;
Report "" to Console;
Report "The two interval methods, ContactTimes and ShadowTimes, are used and the overlapping times are reported to the Console.  The logic used in this Mission Plan can be used for other interval methods as well." to Console;
Report "" to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Objects</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Objects

// Shadow Variables
Variable numShadow;
TimeSpanArray EventTimeShadow;
Array EventTypeShadow;
TimeSpan ShadowStartTime;
TimeSpan ShadowStopTime;

// Contact Variables
Variable numContact;
TimeSpanArray EventTimeContact;
Array EventTypeContact;
TimeSpan ContactStartTime;
TimeSpan ContactStopTime;

// Accounting Varibles
Variable i;
TimeSpan LaterStartTime;
TimeSpan EarlierStopTime;

// Plot Window
PlotWindow pw ({Spacecraft1.Epoch.ConvertToCalendarDate , Spacecraft1.InShadow(Earth, Moon), Spacecraft1.Contact(GroundStation1)});
pw.PlotTitle.Text = "Contact and Light Times";
pw.XAxis.Title.Text = "Time";
pw.YAxis.Title.Text = "True/False";
pw.UseMonitorMode = 1;

pw.ScatterSeries[0].Label = "Light";
pw.ScatterSeries[0].LineOptions.Color = ColorTools.Red;
pw.ScatterSeries[0].LineOptions.Style = 1;
pw.ScatterSeries[0].LineOptions.Width = 3;

pw.ScatterSeries[1].Label = "Contact";
pw.ScatterSeries[1].LineOptions.Color = ColorTools.Blue;
pw.ScatterSeries[1].LineOptions.Style = 0;
pw.ScatterSeries[1].LineOptions.Width = 3;

// ViewWindow
ViewWindow1.SetShowName(GroundStation1.DisplayName, 1);
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>While (Spacecraft1.ElapsedTime &lt; TS(2 days));</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[While (Spacecraft1.ElapsedTime < TS(2 days));]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Contact and Shadow</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Contact and Shadow

Console.CurrentTextColor = ColorTools.Aqua;
// Determine number of contacts and populate event arrays
numShadow = Spacecraft1.ShadowTimes(EventTimeShadow, EventTypeShadow);
numContact = Spacecraft1.ContactTimes(GroundStation1, EventTimeContact, EventTypeContact);

// Determine Spacecraft enter and exit times from shadows
If (numShadow > 0);
	For i = 0 to numShadow-1;
		If (EventTypeShadow[i] == 2 or EventTypeShadow[i]== 102 or EventTypeShadow[i] == 202);
			ShadowStopTime = EventTimeShadow[i];
		Else;
			ShadowStartTime = EventTimeShadow[i];
		End;
	End;
End;

// If there is Contact then record the start/stop time.
If (numContact > 0);
	For i = 0 to numContact-1;
		If (EventTypeContact[i] == 1);
			ContactStartTime = EventTimeContact[i];
		Else;
			ContactStopTime = EventTimeContact[i];
		End;
	End;
End;

// Look for later start time
If (ShadowStopTime > ContactStartTime);
	LaterStartTime = ShadowStopTime;
Else;
	LaterStartTime = ContactStartTime;
End;


// Look for earlier stop time
If (ShadowStartTime < ContactStopTime);
	EarlierStopTime = ShadowStartTime;
Else;
	EarlierStopTime = ContactStopTime;
End;


// Look for times when both start times occur before a stop time
If (LaterStartTime < EarlierStopTime);

	Report "The Spacecraft is in the light and in view of the GroundStation from:" to Console;
	Report "	", LaterStartTime.ConvertToCalendarDate() to Console;
	Report "to:" to Console;
	Report "	", EarlierStopTime.ConvertToCalendarDate() to Console;
	Report "" to Console;

	// Reset Variables
	ShadowStartTime = TimeSpan.Zero;
	ContactStartTime = TimeSpan.Zero;
	LaterStartTime = TimeSpan.Zero;
	ShadowStopTime = TimeSpan.Zero;
	ContactStopTime = TimeSpan.Zero;
	EarlierStopTime = TimeSpan.Zero;

End;

// Update Output Windows
Update pw;
Update ViewWindow1;

// Step Spacecraft
Step Spacecraft1;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>End;</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands></ProjectMissionSequence>

</FreeFlyerMissionPlan>
