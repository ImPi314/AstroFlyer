  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan calculates the torques and angular momentum from: drag, 
// magnetic fields, and gravitational forces acting on an orbiting spacecraft.


// Console Setup
Console.Dimension = 40;
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Yellow;
Console.WordWrap = 1;
Console.Show();

Report "This Mission Plan calculates the torques and angular momentum from: drag, magnetic fields, and gravitational forces acting on an orbiting spacecraft." to Console;
Report "" to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Objects</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Create Objects

// Create Arrays
Array BodyAreaBCS[3];
Array BodyCoPBCS[3];

Array DragMomentumBCS[3];
Array DragTorqueBCS[3];

Array EarthRotation[3];
Array EarthRotationCorrection[3];
Array EffectiveArea[3];

Array GravMomentumBCS[3];
Array GravTorqueBCS[3];

Array IntegratedMomentumBCS[3];

Array MagneticMomentumBCS[3];
Array MagneticField[3];
Array MagneticTorqueBCS[3];
Array MomentArm[3];

Array PosBCS[3];
Array PosMJ2000[3];

Array TorqueRod[3];

Array UnitizedVelBCS[3];
Array UnitizedPosBCS[3];

Array VelBCS[3];
Array VelMJ2000[3];
Array VelRot[3];

Array PosECEF[3];

// Create Variables
Constant Variable EarthMu = Earth.Mu;
Constant Variable EarthOmega = 7.29211502e-005; // Earth rotation rate in rad/sec

Variable index;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Initialize Physical Constants</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Initialize Physical Constants

// Body projected area in Body Coordinate System
BodyAreaBCS = {5.94, 13.75, 10.4}; // m^2

// Body center of pressue in Body Coordinate System
BodyCoPBCS = {0.0047, -0.82144, 2.84139}; // m 

// Magnetic moment of the toqrue rod 
TorqueRod = {15, 0.0716, 0.0716}; // Amp*m^2

// Override Object Browser Spacecraft/Attitude panel
// Produces one revolution of spacecraft attitude per orbit
Spacecraft1.EulerRates[2] = 360 / (60*Spacecraft1.Period);  // Converting period from minutes to seconds
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>While (Spacecraft1.ElapsedTime &lt; TS(100 minutes));</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[While (Spacecraft1.ElapsedTime < TS(100 minutes));]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Initialize Pos/Vel arrays</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Initialize Pos/Vel arrays

// Position in MJ2000 coordinates
PosMJ2000 = Spacecraft1.Position;

// Velocity in MJ2000 coordinates
VelMJ2000 = Spacecraft1.Velocity;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Convert Pos/Vel to BCS</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Convert Pos/Vel to BCS

// Initialize EarthAngularVelocity as Earth angular velocity vector
EarthRotation = {0, 0, EarthOmega};  // Earth rotation rate in rad/sec

PosECEF = PositionConvert(1,Earth.ReferenceFrameIDs.BodyFixed, Spacecraft1.Epoch, PosMJ2000);
EarthRotationCorrection = EarthRotation.CrossProduct(PosECEF); // PosMJ2000;

// Earth relative velocity
// Vallado eq. 3-23
VelRot = VelMJ2000 - EarthRotationCorrection;


// Convert position and relative velocity to BCS
PosBCS = AttitudeConvert(0, 3, Spacecraft1, PosMJ2000);  // Convert position and relative velocity to BCS
VelBCS = AttitudeConvert(0, 3, Spacecraft1, VelRot);     // VelECEF;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Calculate Drag Area</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Calculate Drag Area

// Unitize BCS Velocity vector
UnitizedVelBCS = VelBCS.Normalized();

// Initialize Drag Area to zero
Spacecraft1.DragArea = 0;


// Calculate Spacecraft.DragArea, the cross sectional area incident to the velocity direction. 
// It is used in the calculation of Spacecraft.Drag, the force on the spacecraft due to 
// atmospheric Drag.

For index = 0 to 2;
	EffectiveArea[index] = BodyAreaBCS[index] * UnitizedVelBCS[index];
End;

Spacecraft1.DragArea = EffectiveArea.Norm();
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Calculate Torques</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Calculate Torques

// DRAG //
// Compute aerodynamic moment arm
MomentArm = {BodyCoPBCS[0] - Spacecraft1.VehicleDryCenterOfMass[0],
             BodyCoPBCS[1] - Spacecraft1.VehicleDryCenterOfMass[1],
			 BodyCoPBCS[2] - Spacecraft1.VehicleDryCenterOfMass[2]}; // m

// Calculate torque due to drag
DragTorqueBCS = MomentArm.CrossProduct(Spacecraft1.Drag); // N*m


// MAGNETIC //
// Get the ambient magnetic field at the Spacecraft's location
MagneticField = Spacecraft1.MagneticField(3); // Tesla

// Rescale magnetic field from nanoTesla to Tesla
For index = 0 to 2;
	MagneticField[index] *= 1e-9;
End;

// Take the cross product of the magnetic moment with the ambient magnetic field
MagneticTorqueBCS = TorqueRod.CrossProduct(MagneticField); // N*m


// GRAVITATIONAL //
// Calculate gravitational torque
UnitizedPosBCS = PosBCS.Normalized();

GravTorqueBCS = (3*EarthMu)/PosBCS.Norm()^3 * 
				 ([UnitizedPosBCS].CrossProduct(Spacecraft1.MOI*[UnitizedPosBCS].Transpose())).ToArrayRowMajor(); // N*m
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Calculate Angular Momentum</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Calculate Angular Momentum

For index = 0 to 2;
	
	// Calculate the sum of the torques on the Spacecraft
	TotalTorqueBCS[index] 		 = DragTorqueBCS[index] + GravTorqueBCS[index] + MagneticTorqueBCS[index]; // N*m
	
	// Calculate angular momentum components for the Spacecraft
	DragMomentumBCS[index] 		 = DragTorqueBCS[index] * Spacecraft1.Propagator.StepSize.ToSeconds; //(km*m^2)/sec
	GravMomentumBCS[index] 		 = GravTorqueBCS[index] * Spacecraft1.Propagator.StepSize.ToSeconds; //(km*m^2)/sec
	MagneticMomentumBCS[index] 	 = MagneticTorqueBCS[index] * Spacecraft1.Propagator.StepSize.ToSeconds; //(km*m^2)/sec
	
	// Calculate total angular momentum
	TotalMomentumBCS[index] 	 = DragMomentumBCS[index] + GravMomentumBCS[index];
	IntegratedMomentumBCS[index] += TotalMomentumBCS[index];

End;

MagDragMomentumBCS = DragMomentumBCS.Norm();
MagGravMomentumBCS = GravMomentumBCS.Norm();
MagMagneticMomentumBCS = MagneticMomentumBCS.Norm();
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Report to File</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Report to File

Report Spacecraft1.ElapsedTime.ToMinutes, DragMomentumBCS, GravMomentumBCS, 
	MagneticMomentumBCS, TotalMomentumBCS, IntegratedMomentumBCS
	to "..\_Output_Files\DragGravitationalMagneticMomentum.txt";
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Spacecraft1.Step();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[Spacecraft1.Step();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>ThreeDView.Update();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[ThreeDView.Update();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>TorquePlots.Update();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[TorquePlots.Update();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>MomentumPlots.Update();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[MomentumPlots.Update();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>MomentumComponents.Update();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[MomentumComponents.Update();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>End;</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands></ProjectMissionSequence>

</FreeFlyerMissionPlan>
