  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Sample Mission Plan propagates a Spacecraft in a Highly Elliptical Orbit (HEO)
// using the Runge-Kutta 8(9) propagator in Variable Step Size mode.

// Notice that as the spacecraft approaches Perigee the velocity of the spacecraft increases,
// and therefore FreeFlyer must decrease the integration step size in order to satisfy the 
// user-defined error tolerance.  However, as the spacecraft approaches Apogee the velocity 
// of spacecraft decreases, and therefore FreeFlyer does not require the integration step size 
// to be so small in order to satisfy the user-defined error tolerance.  Therefore, the 
// integration step size increases.


// Console Setup

Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.White;
Console.Dimension = 50;
Console.Show();
Console.WindowTitle = "Mission Plan Description";
Console.WordWrap = 1;

Report "This Sample Mission Plan propagates a Spacecraft in a Highly Elliptical Orbit (HEO) using the Runge-Kutta 8(9) propagator in Variable Step Size mode." to Console;
Report " " to Console;

Report "Notice that as the spacecraft approaches Perigee the velocity of the spacecraft increases, and therefore FreeFlyer must decrease the integration step size in order to satisfy the user-defined error tolerance.  However, as the spacecraft approaches Apogee the velocity of spacecraft decreases, and therefore FreeFlyer does not require the integration step size to be so small in order to satisfy the user-defined error tolerance.  Therefore, the integration step size increases." to Console;
Report " " to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Report Header</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
//Report Header

Report "Epoch					   Propagation Step Size (sec)  	Height (km) "to ReportInterface1 without headers without pad;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>While (Spacecraft1.ElapsedTime &lt; TS(5 days));</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[While (Spacecraft1.ElapsedTime < TS(24.0 hours));]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Report Generation</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Report Generation

// Send report to output file
Report Spacecraft1.EpochText, 
		(Spacecraft1.Propagator AsType RK89).StepJustTaken<10,3>,
		"		     ",
		Spacecraft1.Height 
		to ReportInterface1 without headers;

// Default color is white
Spacecraft1.Color     = ColorTools.White;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Report to Console Window</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Report to Console Window

// Send Apogee report to Console
If (Spacecraft1.Height > 40000);

	Spacecraft1.Color = ColorTools.Red;
	Console.CurrentTextColor = ColorTools.Red;

	If (ApogeeFlag == 1);
		Report " " to Console;
		Report "Spacecraft approaching apogee..." to Console;
		Report " " to Console;
		Report "Epoch			  							Propagation  	   Height (km) " to Console;
		Report "     								  			Step Size (sec)" to Console;
		ApogeeFlag = 0;
	End;

	Report Spacecraft1.EpochText, "	", 
			(Spacecraft1.Propagator AsType RK89).StepJustTaken<10,3>,
			"   		  ",
			Spacecraft1.Height<10,3> to Console;

Else;

	ApogeeFlag = 1;

End;

// Send Perigee report to Console
If (Spacecraft1.Height < 8000);

	Spacecraft1.Color = ColorTools.Lime;
	Console.CurrentTextColor = ColorTools.Lime;

	If (PerigeeFlag == 1);
		Report " " to Console;		
		Report "Spacecraft approaching perigee..." to Console;
		Report " " to Console;	
		Report "Epoch			  							Propagation  	   Height (km) " to Console;
		Report "     								  			Step Size (sec)" to Console;
		PerigeeFlag = 0;
	End;

	Report Spacecraft1.EpochText, "	", 
			(Spacecraft1.Propagator AsType RK89).StepJustTaken<10,3>,
			"   		  ", 
			Spacecraft1.Height<10,3> to Console;

Else;

	PerigeeFlag = 1;

End;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Spacecraft1.Step();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[Spacecraft1.Step();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>ViewWindow2.Update();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[ViewWindow1.Update();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>End;</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[End;]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands></ProjectMissionSequence>

</FreeFlyerMissionPlan>
