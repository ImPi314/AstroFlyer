        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[View Spacecraft1,GroundStation1<800>,GroundStation3<800>,GroundStation2<800>,GroundStation4<800>;]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Update DataTableWindow</Label>
