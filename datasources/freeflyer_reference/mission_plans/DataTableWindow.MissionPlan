      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan demonstrates use of the DataTableWindow in a simple orbit propagation
// scenario.  See also the Report Sample Mission Plan as an alternate approach. The DataTableWindow, 
// when compared with the Report command, allows greater control over titles and update modes.

// The DataTableWindow can be updated automatically every time a Spacecraft is stepped
// or maneuvered, or it can be updated manually using the Update command.  In this 
// example, the DataTableWindow is set to update automatically using the Update command. 


// Console Setup
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Yellow;
Console.Dimension = 35;
Console.WordWrap = 1;
Console.Show();

Report @"This Mission Plan demonstrates use of the DataTableWindow in a simple orbit propagation scenario.  See also the \"Report\" Sample Mission Plan as an alternate approach.  The DataTableWindow, when compared with the Report command, allows greater control over titles and update modes." to Console;
Report "" to Console;

Report "The DataTableWindow can be updated automatically every time a Spacecraft is stepped or maneuvered, or it can be updated manually using the Update command.  In this example, the DataTableWindow is set to update automatically using the Update command. " to Console;
Report "" to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Data Table Window</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Create DataTableWindow

DataTableWindow DataTableWindow1({Spacecraft1.ElapsedTime.ToMinutes(), Spacecraft1.Latitude, Spacecraft1.Longitude, Spacecraft1.Contact(GroundStation1), Spacecraft1.Contact(GroundStation2), Spacecraft1.Contact(GroundStation3), Spacecraft1.Contact(GroundStation4)});
]]></FreeFormScript>
      </FreeForm>
