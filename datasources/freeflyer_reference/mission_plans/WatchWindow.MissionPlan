      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan demonstrates use of the WatchWindow in a simple orbit lifetime
// analysis.  See also the Watch Sample Mission Plan as an alternate approach.  The 
// WatchWindow allows greater control of titles and update modes other than the Watch 
// command.

// The WatchWindow can be updated automatically every time a Spacecraft is stepped
// or maneuvered, or it can be updated manually using the Update command.  In this 
// example, the WatchWindow is set to update automatically via the Properties page 
// of the WatchWindow object editor. 


// Console Setup
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Yellow;
Console.Dimension = 36;
Console.WordWrap = 1;
Console.Show();

Report @"This Mission Plan demonstrates use of the WatchWindow in a simple orbit lifetime analysis.  See also the \"Watch\" Sample Mission Plan as an alternate approach.  The WatchWindow allows for greater control of titles and update modes other than the Watch command." to Console;
Report "" to Console;

Report "The WatchWindow can be updated automatically every time a Spacecraft is stepped or maneuvered, or it can be updated manually using the Update command.  In this example, the WatchWindow is set to update automatically via the Properties page of the WatchWindow object editor. " to Console;
Report "" to Console;
]]></FreeFormScript>
      </FreeForm>
