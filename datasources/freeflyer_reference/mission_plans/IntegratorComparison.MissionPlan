  <ProjectMissionSequence>
    <ProjectExternals/>
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Mission Plan Description and Console Setup</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Mission Plan Description and Console Setup

// This Mission Plan shows the variation when propagating spacecraft using the propagators built into FreeFlyer.

// Console Setup
Console.BackColor = ColorTools.Black;
Console.CurrentTextColor = ColorTools.Lime;
Console.Dimension = 35;
Console.WordWrap = 1;
Console.Show();

Report "" to Console;
Report "This Mission Plan shows the variation when propagating spacecraft using the propagators built in to FreeFlyer." to Console;

Console.CurrentTextColor = BulirschStoer.Color;
Report "" to Console;
Report "The BulirschStoer Spacecraft is this color." to Console;
Console.CurrentTextColor = CowellSC.Color;
Report "" to Console;
Report "The Cowell Spacecraft is this color." to Console;
Console.CurrentTextColor = J2MeanSC.Color;
Report "" to Console;
Report "The J2Mean Spacecraft is this color." to Console;
Console.CurrentTextColor = RungeKutta45.Color;
Report "" to Console;
Report "The RungeKutta45 Spacecraft is this color." to Console;
Console.CurrentTextColor = RungeKutta78.Color;
Report "" to Console;
Report "The RungeKutta78 Spacecraft is this color." to Console;
Console.CurrentTextColor = RungeKutta89.Color;
Report "" to Console;
Report "The RungeKutta89 Spacecraft is this color." to Console;
Console.CurrentTextColor = SGP4SC.Color;
Report "" to Console;
Report "The SGP4 Spacecraft is this color." to Console;
Console.CurrentTextColor = TwoBodySC.Color;
Report "" to Console;
Report "The TwoBody Spacecraft is this color." to Console;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Create Plot Window</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Create Plot Window

PlotWindow PlotWindow1({RungeKutta89.ElapsedTime, RungeKutta89.Range(BulirschStoer), RungeKutta89.Range(CowellSC), RungeKutta89.Range(J2MeanSC), RungeKutta89.Range(RungeKutta45), RungeKutta89.Range(RungeKutta78), RungeKutta89.Range(SGP4SC), RungeKutta89.Range(TwoBodySC)});
PlotWindow1.PlotTitle.Text = "Distance from RungeKutta89";
PlotWindow1.YAxis.Title.Text = "Distance (km)";
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>While (RungeKutta89.ElapsedTime &lt; TS(5 days));</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[While (RungeKutta89.ElapsedTime < TS(5 days));]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Update Windows</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[
// Update Windows

Update PlotWindow1;
Update ViewWindow1;
]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>RungeKutta89.Step();</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[RungeKutta89.Step();]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Step BulirschStoer to (BulirschStoer.Epoch == RungeKutta89.Epoch);</Label>
        <Bookmarks/>
        <Breakpoints/>
        <FreeFormScript><![CDATA[Step BulirschStoer to (BulirschStoer.Epoch == RungeKutta89.Epoch);]]></FreeFormScript>
      </FreeForm>
      <FreeForm enabled="true">
        <Label>Step J2MeanSC to (J2MeanSC.Epoch == RungeKutta89.Epoch);</Label>
        <Bookmarks/>
        <Breakpoints/>
